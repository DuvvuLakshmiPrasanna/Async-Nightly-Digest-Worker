# ------------------------------------------------------------------
# Nightly Digest Worker - Environment Variables
# Copy this file to `.env` and adjust values as needed.
# No real secrets are stored here; all values are safe placeholders.
# ------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Port the Express API server listens on inside the container
# (also the port published to the host - see docker-compose.yml)
API_PORT=3000

# ---------------- PostgreSQL ----------------
# These values are used both by the docker-compose `db` service
# to bootstrap the database and by the app/worker to connect to it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=digest_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection string derived from the values above.
# Used directly by the Node.js pg client.
DATABASE_URL=postgresql://postgres:postgres@db:5432/digest_db

# ---------------- Redis / Queue ----------------
# Connection string for the BullMQ async job queue.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Name of the BullMQ queue used for the nightly digest job
QUEUE_NAME=digest_queue

# Which queue implementation is in use (documented for evaluators)
QUEUE_IMPLEMENTATION=redis

# ---------------- Scheduler ----------------
# Standard cron expression controlling when the nightly digest
# is triggered automatically (default: every day at midnight).
CRON_SCHEDULE=0 0 * * *

# Set to "true" to disable the cron scheduler (useful in CI/tests)
DISABLE_CRON=false
